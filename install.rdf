<?xml version='1.0' encoding='utf-8'?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:em="http://www.mozilla.org/2004/em-rdf#">

	<Description about="urn:mozilla:install-manifest">

		<!-- Required Items -->
		<em:id>preparse@adoxa</em:id>
		<em:name>Preparse</em:name>
		<em:version>0.8</em:version>
		<em:description>Modify HTML &amp; Javascript to address some issues.</em:description>
		<em:creator>Jason "adoxa" Hood</em:creator>
		<em:contributor>Ben Murphy (Javascript Deminifier)</em:contributor>
		<em:contributor>dinosaur</em:contributor>
		<em:contributor>Kagami Hiiragi (avif.js)</em:contributor>
		<em:contributor>yup (localisation)</em:contributor>
		<em:translator>yup (ru)</em:translator>

		<em:localized>
			<Description>
				<em:locale>ru</em:locale>
				<em:name>Preparse</em:name>
				<em:description>На лету изменяет файлы HTML и Javascript для улучшения совместимости с отдельными сайтами.</em:description>
			</Description>
		</em:localized>

		<em:targetApplication>
			<Description>
				<!-- Basilisk -->
				<em:id>{ec8030f7-c20a-464f-9b0e-13a3a9e97384}</em:id>
				<em:minVersion>52.9.2023.05.17</em:minVersion>
				<em:maxVersion>55.*</em:maxVersion>
			</Description>

			<Description>
				<!-- Pale Moon -->
				<em:id>{8de7fcbb-c55c-4fbe-bfc5-fc555c87dbc4}</em:id>
				<em:minVersion>32.2.0</em:minVersion>
				<em:maxVersion>35.*</em:maxVersion>
			</Description>

			<Description>
				<!-- Iceape-UXP -->
				<em:id>{9184b6fe-4a5c-484d-8b4b-efbfccbfb514}</em:id>
				<em:minVersion>2.0a</em:minVersion>
				<em:maxVersion>2.56</em:maxVersion>
			</Description>
		</em:targetApplication>

	</Description>
</RDF>
